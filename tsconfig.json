{
  "compilerOptions": {
    "strict": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "module": "esnext",
    "target": "ESNext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "jsx": "react",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["./**/*.js", "./global.d.ts"]
}
